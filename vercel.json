{
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trial-expiry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/renewal-reminder",
      "schedule": "30 3 * * *"
    }
  ]
}
