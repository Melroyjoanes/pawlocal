{
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/trial-expiry",            "schedule": "0 1 * * *"  },
    { "path": "/api/cron/renewal-reminder",        "schedule": "0 8 * * *"  },
    { "path": "/api/cron/weekly-summary",          "schedule": "0 9 * * 1"  },
    { "path": "/api/cron/payment-reconciliation",  "schedule": "0 20 * * *" },
    { "path": "/api/cron/walker-noshow",           "schedule": "30 14 * * *" }
  ]
}
